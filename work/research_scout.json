    {
      "parameters": {
        "jsCode": "// Data समात्ने र Text format मा रुपान्तरण गर्ने\nconst inputItem = $input.first().json;\nlet xmlString = \"\";\n\nif (typeof inputItem === 'string') {\n  xmlString = inputItem;\n} else if (inputItem.data) {\n  xmlString = typeof inputItem.data === 'string' ? inputItem.data : JSON.stringify(inputItem.data);\n} else if (inputItem.body) {\n  xmlString = typeof inputItem.body === 'string' ? inputItem.body : JSON.stringify(inputItem.body);\n} else {\n  xmlString = JSON.stringify(inputItem);\n}\n\n// Entry छ्ट्याउने\nconst entries = xmlString.split('<entry>').slice(1);\n\nif (entries.length === 0) {\n  return [{ json: { title: \"Error Fetching Paper\", summary: \"Please re-execute the HTTP Request node first.\", link: \"\" } }];\n}\n\nreturn entries.slice(0, 1).map(entry => {\n  const titleMatch = entry.match(/<title>([\\s\\S]*?)<\\/title>/);\n  const summaryMatch = entry.match(/<summary>([\\s\\S]*?)<\\/summary>/);\n  const linkMatch = entry.match(/<id>([\\s\\S]*?)<\\/id>/);\n\n  return {\n    json: {\n      title: titleMatch ? titleMatch[1].replace(/\\n/g, ' ').trim() : 'No Title',\n      summary: summaryMatch ? summaryMatch[1].replace(/\\n/g, ' ').trim() : 'No Summary',\n      link: linkMatch ? linkMatch[1].trim() : ''\n    }\n  };\n});"
      },
